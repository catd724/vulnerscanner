{
  "name": "ai-terminal-vuln-scanner",
  "productName": "AI Terminal",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered terminal with integrated vulnerability scanning, risk analysis, and patch synthesis.",
  "main": "main.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint .",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "archiver": "^7.0.1",
    "next": "16.2.10",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serve-static": "^2.2.1",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^6.0.1",
    "ssh2": "^1.17.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "ai.terminal.client",
    "productName": "AI Terminal",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sqlite3/**/*",
      "node_modules/ssh2/**/*",
      "node_modules/cpu-features/**/*"
    ],
    "files": [
      "main.js",
      "server.js",
      "package.json",
      "server/**/*",
      "public/**/*",
      ".next/**/*",
      "!.next/**/node_modules/**/*",
      "!.next/**/cache/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
