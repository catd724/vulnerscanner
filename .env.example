# terminal.ai environment
# Copy to .env.local. Every value is optional.

# Port and interface for the local server.
# Keep HOST on the loopback address: this process can open authenticated SSH
# sessions and bind tunnel ports, so it should never listen publicly.
PORT=3000
HOST=127.0.0.1

# Where the encrypted vault lives. Defaults to ./connections.db in development
# and to the Electron userData folder in a packaged build.
# DB_PATH=./connections.db

# --- AI assistant (optional) ------------------------------------------------
# Powers the Ctrl+Shift+I overlay and vulnerability analysis.
# Without a key the assistant returns 503 and the rest of the app works normally.
# OpenCode Go is used first if configured; otherwise OpenRouter is used.
OPENCODE_GO_API_KEY=
# OPENCODE_GO_API_URL=https://api.opencode.go/v1/chat/completions
# OPENCODE_GO_MODEL=kimi-k2.5-code

# Fallback / alternative provider: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model slug OpenRouter accepts.
# AI_MODEL=anthropic/claude-sonnet-4.5

# --- Branding ---------------------------------------------------------------
# Point this at your own logo file in public/ to replace the built-in mark.
# NEXT_PUBLIC_BRAND_LOGO=/logo.svg
